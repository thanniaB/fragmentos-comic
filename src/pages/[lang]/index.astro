---
import { getLocaleParams, useTranslations, type Lang } from "@/i18n";
import Layout from "@/layouts/Base.astro";
const t = useTranslations(Astro.currentLocale as Lang);

export const getStaticPaths = () => getLocaleParams(import.meta.url);
---

<Layout>
  <main>
    <h2>
      {
        t({
          es: "Fragmentos de Dragón",
          en: "Thorns of a Dragon",
        })
      }
    </h2>
  </main>
</Layout>

<style>
  main {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100vh;
    background-image: url('../../assets/portada_temporal.jpg');
    background-size: cover;
    padding-inline: 0;
  }

  h2 {
    width: 100%;
    text-align: center;
    font-family: var(--font-piston-black), serif;
    font-size: 4rem;
    -webkit-text-stroke: 1px #A48D14;
    background-color: rgb(0,0,0,0.5);
    padding-block: var(--sp-m);
  }

</style>
