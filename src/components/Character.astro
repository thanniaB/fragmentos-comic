---
interface Props {
    name: string;
    imageSrc: any;
    description: string;
}

const { name, imageSrc, description } = Astro.props;
---

<div class="character-profile">
    <img src={imageSrc} />
    <div>
        <h2>{name}</h2>
        <p>{description}</p>
    </div>
</div>

<style>
    .character-profile {
        display: flex;
        margin-bottom: var(--sp-s);

        img {
            margin-inline-end: var(--sp-xs);
            max-width: 120px;
        }
    }
</style>
